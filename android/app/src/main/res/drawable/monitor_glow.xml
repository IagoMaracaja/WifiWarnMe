<!-- Stacked translucent pills fake a soft blur around the ribbon once tinted. Sized for the 18dp
     ribbon frame, whose 8dp bar sits 5dp inside it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#14FFFFFF"/><corners android:radius="9dp"/></shape></item>
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp"><shape android:shape="rectangle"><solid android:color="#1EFFFFFF"/><corners android:radius="7dp"/></shape></item>
    <item android:left="4dp" android:right="4dp" android:top="4dp" android:bottom="4dp"><shape android:shape="rectangle"><solid android:color="#2CFFFFFF"/><corners android:radius="5dp"/></shape></item>
</layer-list>
