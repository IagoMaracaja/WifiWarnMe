<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker image before Android 12 (previewLayout is used from Android 12 on). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="180dp" android:height="56dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_background"/>
            <stroke android:width="1dp" android:color="@color/card_border"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item android:left="10dp" android:top="12dp" android:width="32dp" android:height="32dp">
        <shape android:shape="rectangle"><solid android:color="#3320E3A2"/><corners android:radius="10dp"/></shape>
    </item>
    <item android:left="16dp" android:top="18dp" android:width="20dp" android:height="20dp" android:drawable="@drawable/widget_preview_wifi"/>
    <item android:left="52dp" android:top="15dp" android:width="88dp" android:height="9dp">
        <shape android:shape="rectangle"><solid android:color="#F4F8FB"/><corners android:radius="4dp"/></shape>
    </item>
    <item android:left="52dp" android:top="32dp" android:width="7dp" android:height="7dp">
        <shape android:shape="oval"><solid android:color="#20E3A2"/></shape>
    </item>
    <item android:left="64dp" android:top="31dp" android:width="44dp" android:height="9dp">
        <shape android:shape="rectangle"><solid android:color="#20E3A2"/><corners android:radius="4dp"/></shape>
    </item>
</layer-list>
