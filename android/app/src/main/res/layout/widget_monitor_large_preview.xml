<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+) of widget_monitor_large, with sample values. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LinkzoraWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">
            <ImageView
                android:id="@+id/monitor_tile_fill"
            android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:alpha="0.16"
                android:src="@drawable/monitor_tile_fill_small"
                android:tint="#20E3A2" />
            <ImageView
                android:id="@+id/monitor_tile_stroke"
            android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:alpha="0.35"
                android:src="@drawable/monitor_tile_stroke_small"
                android:tint="#20E3A2" />
            <ImageView
                android:id="@+id/monitor_icon"
            android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_monitor_wifi"
                android:tint="#20E3A2" />
            <ImageView
            android:id="@+id/widget_brand"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Linkzora"
            android:src="@mipmap/ic_launcher_round" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/monitor_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_network"
                android:textColor="@color/card_text"
                android:textSize="16sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/monitor_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/monitor_circle"
                    android:tint="#20E3A2" />
                <TextView
                    android:id="@+id/monitor_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/card_title_online"
                    android:textColor="#20E3A2"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/monitor_detail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:layout_marginStart="5dp"
                    android:maxLines="1"
                    android:text="@string/card_subtitle_online"
                    android:textColor="@color/card_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <include layout="@layout/widget_actions" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="5dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_preview_ribbon" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/ping_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/card_ping"
            android:textColor="@color/card_secondary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/ping_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="24 ms"
            android:textColor="#20E3A2"
            android:textSize="13sp"
            android:textStyle="bold" />
        <ImageView
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@color/card_divider"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/jitter_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/card_jitter"
            android:textColor="@color/card_secondary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/jitter_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="3 ms"
            android:textColor="#28B8F0"
            android:textSize="13sp"
            android:textStyle="bold" />
        <!-- Weighted so the time is never cut; the label ellipsizes instead on narrow widgets. -->
        <TextView
            android:id="@+id/last_check_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/card_last_check"
            android:textColor="@color/card_secondary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/last_check_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="11:04"
            android:textColor="@color/card_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
