<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+) of widget_monitor_small, with sample values. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        style="@style/LinkzoraWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp">
        <ImageView
            android:id="@+id/monitor_tile_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:alpha="0.16"
            android:src="@drawable/monitor_tile_fill_small"
            android:tint="#20E3A2" />
        <ImageView
            android:id="@+id/monitor_tile_stroke"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:alpha="0.35"
            android:src="@drawable/monitor_tile_stroke_small"
            android:tint="#20E3A2" />
        <ImageView
            android:id="@+id/monitor_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_monitor_wifi"
            android:tint="#20E3A2" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/monitor_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_network"
            android:textColor="@color/card_text"
            android:textSize="14sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/monitor_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:importantForAccessibility="no"
                android:src="@drawable/monitor_circle"
                android:tint="#20E3A2" />
            <TextView
                android:id="@+id/widget_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="24 ms"
                android:textColor="#20E3A2"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:layout_marginStart="5dp"
                android:text="@string/card_title_online"
                android:textColor="@color/card_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
